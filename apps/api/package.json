{
  "name": "@pptx/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import=@poppinss/ts-exec bin/server.ts",
    "build": "tsc && node scripts/prepare_build.mjs",
    "start": "node --env-file-if-exists=.env build/bin/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import=tsx --test tests/*.test.ts"
  },
  "imports": {
    "#start/*": "./start/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#services/*": "./app/services/*.js",
    "#exceptions/*": "./app/exceptions/*.js"
  },
  "dependencies": {
    "@adonisjs/core": "^7.6.0",
    "@pptx/contracts": "*",
    "@poppinss/ts-exec": "^1.5.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/tsconfig": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
