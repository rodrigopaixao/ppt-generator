{
  "name": "context-slide-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "extract": "python3 scripts/native_deck.py catalog",
    "extract:responsive": "python3 scripts/extract.py",
    "build": "node src/generate.mjs --config config.quality.json",
    "build:responsive": "node src/generate.mjs --mode responsive",
    "build:debug": "node src/generate.mjs --mode responsive --debug",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p '*_test.py'",
    "verify": "python3 scripts/verify.py",
    "verify:visual": "python3 scripts/visual_review.py",
    "docs:check": "python3 scripts/check_docs.py",
    "build:fidelity": "node src/generate.mjs",
    "build:quality": "node src/generate.mjs --config config.quality.json --output output/reviewed-slides.pptx",
    "verify:quality": "python3 scripts/review_quality.py",
    "verify:keynote": "python3 scripts/review_keynote.py"
  },
  "dependencies": {
    "pptxgenjs": "4.0.1",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=20"
  }
}
